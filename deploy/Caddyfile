# Caddy fetches and renews a Let's Encrypt certificate on its own.
# Twilio will not post a webhook to plain HTTP, so this is not optional
# once the SMS backend is switched from mock to twilio.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Static files are served by WhiteNoise inside the app, so everything
	# goes to one upstream. One less thing to keep in sync.
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
